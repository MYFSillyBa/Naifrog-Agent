<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Naifrog/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../src/Naifrog/Chat/*.cs" Link="Chat/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
