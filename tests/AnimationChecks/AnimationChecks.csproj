<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Naifrog/Core/AppSettings.cs" Link="Core/AppSettings.cs" />
    <Compile Include="../../src/Naifrog/Core/AgentSettings.cs" Link="Core/AgentSettings.cs" />
    <Compile Include="../../src/Naifrog/Animation/*.cs" Link="Animation/%(Filename)%(Extension)" />
    <Resource Include="../../src/Naifrog/Assets/naifrog.png" Link="Assets/naifrog.png" />
  </ItemGroup>
</Project>
