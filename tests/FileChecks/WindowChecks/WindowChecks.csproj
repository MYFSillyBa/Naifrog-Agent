<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/Naifrog/Core/AppSettings.cs" Link="Core/AppSettings.cs" />
    <Compile Include="../../../src/Naifrog/Core/AgentSettings.cs" Link="Core/AgentSettings.cs" />
    <Compile Include="../../../src/Naifrog/Core/SettingsStore.cs" Link="Core/SettingsStore.cs" />
    <Compile Include="../../../src/Naifrog/Files/*.cs" Link="Files/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
